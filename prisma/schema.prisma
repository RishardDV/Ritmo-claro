generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "postgresql"
}

enum Role {
  USUARIO
  ADMIN
}

enum Estado {
  ACTIVO
  PAUSADO
  ARCHIVADO
}

enum Frecuencia {
  DIARIA
  SEMANAL
  MENSUAL
}


model Actores {
  id        Int       @id @default(autoincrement())
  nombre    String
  email     String    @unique
  password  String
  rol       Role      @default(USUARIO)
  habitos   Habitos[]
  creadoEn  DateTime  @default(now())

  @@map("actores")
}

model Habitos {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  estado      Estado     @default(ACTIVO)
  frecuencia  Frecuencia @default(DIARIA)
  
  actorId     Int
  actor       Actores  @relation(fields: [actorId], references: [id], onDelete: Cascade)
  creadoEn    DateTime @default(now())

  @@index([actorId])
  @@map("habitos")
}